# Copy to .env.local for local development, and set the same two values
# as Environment Variables in the Vercel project.
#
# The publishable key is meant to be public: it identifies the project and
# grants nothing on its own. Row Level Security decides what a guest can
# read, and guests can only create orders through the submit_guest_order
# function. Never put the service_role key here — that one bypasses RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
